{
  "info": {
    "name": "CivicSense — Civic Issue Platform",
    "description": "Complete API collection for the Civic Issue Reporting & Resolution Platform (SIH)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "civic-sense-api-v1"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "citizenToken", "value": "", "type": "string" },
    { "key": "authorityToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Citizen)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Citizen\",\n  \"email\": \"testcitizen@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Login — Admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);", "pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@civic.local\",\n  \"password\": \"Admin@123456\"\n}" }
          }
        },
        {
          "name": "Login — Authority",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('authorityToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"officer@civic.local\",\n  \"password\": \"Officer@123456\"\n}" }
          }
        },
        {
          "name": "Login — Citizen 1",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('citizenToken', pm.response.json().token);", "pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"citizen1@civic.local\",\n  \"password\": \"Citizen@123456\"\n}" }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Create Issue (with image)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Large pothole on main road", "type": "text" },
                { "key": "description", "value": "There is a very large and deep pothole on the main road near the market. Very dangerous for two-wheelers.", "type": "text" },
                { "key": "category", "value": "POTHOLE", "type": "text" },
                { "key": "latitude", "value": "28.6139", "type": "text" },
                { "key": "longitude", "value": "77.2090", "type": "text" },
                { "key": "locationText", "value": "Main Road, Near Market, New Delhi", "type": "text" },
                { "key": "image", "type": "file", "description": "Upload a pothole image" }
              ]
            }
          }
        },
        {
          "name": "Get All Issues",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/issues?sortBy=priorityScore&sortOrder=desc&limit=20", "query": [
              { "key": "sortBy", "value": "priorityScore" },
              { "key": "sortOrder", "value": "desc" },
              { "key": "limit", "value": "20" }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Issue Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/issues/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Issue by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/issues/:id",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Check Duplicate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/check-duplicate",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090,\n  \"category\": \"POTHOLE\",\n  \"embedding\": []\n}" }
          }
        },
        {
          "name": "Assign Issue to Department (Authority)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/issues/:id/assign",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorityToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"<department_id>\"\n}" }
          }
        },
        {
          "name": "Update Status (Authority)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/issues/:id/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorityToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" }
          }
        },
        {
          "name": "Submit Resolution (Authority)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/:id/resolution",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorityToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "resolutionDescription", "value": "The pothole has been filled with asphalt and road surface restored.", "type": "text" },
                { "key": "image", "type": "file", "description": "Resolution proof photo" }
              ]
            }
          }
        },
        {
          "name": "Verify Resolution — Accept (Citizen)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/:id/verify",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"ACCEPTED\",\n  \"comment\": \"\"\n}" }
          }
        },
        {
          "name": "Verify Resolution — Reject (Citizen)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/:id/verify",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"REJECTED\",\n  \"comment\": \"The road surface is still damaged and pothole is not fully filled.\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get My Linked Reports",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Get Reports for Issue (Authority)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/issue/:issueId",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorityToken}}" }]
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Classify Image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/classify",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "context", "value": "large pothole on the road", "type": "text" },
                { "key": "image", "type": "file", "description": "Optional image file" }
              ]
            }
          }
        },
        {
          "name": "Similarity Score",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/similarity",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"embeddingA\": [0.1, 0.2, 0.3],\n  \"embeddingB\": [0.1, 0.2, 0.25]\n}" }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Get All Departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/departments",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Department (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/departments",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Parks & Recreation\",\n  \"slaHours\": 48,\n  \"authorityLevel\": \"WARD\",\n  \"categories\": [\"OTHER\"]\n}" }
          }
        }
      ]
    },
    {
      "name": "Escalations",
      "item": [
        {
          "name": "Get All Escalations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/escalations",
            "header": [{ "key": "Authorization", "value": "Bearer {{authorityToken}}" }]
          }
        },
        {
          "name": "Process SLA (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/escalations/process",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Manual Escalate (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/escalations/manual",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"issueId\": \"<issue_id>\",\n  \"reason\": \"Manual escalation for demo purposes\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Create Authority User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Officer Singh\",\n  \"email\": \"officer2@civic.local\",\n  \"phone\": \"9876543211\",\n  \"password\": \"Officer@123456\",\n  \"role\": \"AUTHORITY\"\n}" }
          }
        },
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/analytics",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/read-all",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Demo (DEMO_MODE=true only)",
      "item": [
        {
          "name": "Fast Forward +1 hour",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/demo/fast-forward",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"hours\": 1\n}" }
          }
        },
        {
          "name": "Fast Forward +12 hours",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/demo/fast-forward",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"hours\": 12\n}" }
          }
        },
        {
          "name": "Fast Forward +24 hours",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/demo/fast-forward",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"hours\": 24\n}" }
          }
        },
        {
          "name": "Get Demo Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/demo/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    }
  ]
}
