## 🚀 QUICK START — Copy this file to `.env` in the project root and fill in your values

PORT=5000

# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/civic-platform?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Get from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# Duplicate detection settings
DUPLICATE_THRESHOLD=0.75
DUPLICATE_RADIUS_METERS=100

# SIH Demo mode — keep true for presentation
AI_DEMO_MODE=true
DEMO_MODE=true

CLIENT_URL=http://localhost:5173
NODE_ENV=development
